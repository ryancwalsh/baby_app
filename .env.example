# The room's name, shown as the page heading and as the installed PWA's name.
APP_TITLE=
# Short enough for a home screen icon's caption, where APP_TITLE will not fit.
APP_SHORT_NAME=

# Nanit account, for the camera night light.
NANIT_EMAIL_ADDRESS=
NANIT_PASSWORD=

# TP-Link / Tapo account, for the lamp plug.
TAPO_EMAIL_ADDRESS=
TAPO_PASSWORD=
# [[appServerUrl, alias, deviceId, iconName?], ...] — the first three from the
# cloud API's getDeviceList. iconName is optional and names one of the icons in
# components/device-icons.tsx; a device without one gets the default lamp icon.
TAPO_DEVICES=[["https://use1-wap.tplinkcloud.com","lamp","<deviceId>"],["https://use1-wap.tplinkcloud.com","ceiling light","<deviceId>","ceiling_light"]]

# SHA-256 hex of the password the app asks for at startup.
# Generate with: printf 'your password' | sha256sum
LOGIN_SECRET=

# Which half of the app this is: "worker" (the laptop, with the Nanit) or
# "cloud" (Vercel). Defaults to worker. See plan_cloud.md.
APP_ROLE=
# The cloud's origin, e.g. https://baby.example.com, allowed to call the
# worker's /api/worker/* routes from the browser. Empty allows none.
CLOUD_ORIGIN=
# The private Vercel Blob store holding the lullabies.
BLOB_READ_WRITE_TOKEN=
