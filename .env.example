# The room's name, shown as the page heading and as the installed PWA's name.
APP_TITLE=
# Short enough for a home screen icon's caption, where APP_TITLE will not fit.
APP_SHORT_NAME=

# Nanit account, for the camera night light.
NANIT_EMAIL_ADDRESS=
NANIT_PASSWORD=

# Happiest Baby account, for the Snoo bassinet.
SNOO_EMAIL_ADDRESS=
SNOO_PASSWORD=

# TP-Link / Tapo account, for the lamp plug.
TAPO_EMAIL_ADDRESS=
TAPO_PASSWORD=
# [[appServerUrl, alias, deviceId], ...] — from the cloud API's getDeviceList.
TAPO_DEVICES=[["https://use1-wap.tplinkcloud.com","lamp","<deviceId>"],["https://use1-wap.tplinkcloud.com","bedside lamp","<deviceId>"]]

# SHA-256 hex of the password the app asks for at startup.
# Generate with: printf 'your password' | sha256sum
LOGIN_SECRET=
