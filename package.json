{
  "name": "baby_app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && yarn record_commit_hash_and_build_time",
    "record_commit_hash_and_build_time": "./scripts/record_commit_hash_and_build_time.sh",
    "start": "next start -p 2026",
    "deploy": "yarn build && next start -p 2026",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "nanit:login": "tsx --env-file=.env scripts/nanit-login.ts"
  },
  "dependencies": {
    "envalid": "8.2.0",
    "lucide-react": "1.16.0",
    "next": "16.2.11",
    "protobufjs": "8.7.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@next/eslint-plugin-next": "16.3.1",
    "@ryancwalsh/linting": "1.1.0",
    "@tailwindcss/postcss": "4.2.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.23",
    "prettier": "3.6.2",
    "tailwindcss": "4.2.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  },
  "packageManager": "yarn@4.14.1"
}
